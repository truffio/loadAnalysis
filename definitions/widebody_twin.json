  "scenarios": [
    { "id": "S01", "name": "Normal - both generators on line, APU off", "description": "Each generator feeds its own side and its own galley bus.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - APU feeds AC BUS 1", "description": "APU replaces Generator 1, and the forward galley stays on.",
      "states": {"GEN1": "failed", "APLC1": "closed"} },
    { "id": "S03", "name": "Generator 2 loss - APU feeds AC BUS 2", "description": "APU replaces Generator 2, and the aft galley stays on.",
      "states": {"GEN2": "failed", "APLC2": "closed"} },
    { "id": "S04", "name": "Generator 1 and APU loss - cross-tie closed, forward galley shed", "description": "Generator 2 carries both sides with the forward galley contactor open.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed", "GALFC": "open"} },
    { "id": "S05", "name": "Generator 2 and APU loss - cross-tie closed, aft galley shed", "description": "Generator 1 carries both sides with the aft galley contactor open.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed", "GALAC": "open"} },
    { "id": "S06", "name": "APU only - both generators lost, both galleys shed", "description": "Both APU line contactors closed with the cross-tie open.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "APLC2": "closed", "GALFC": "open", "GALAC": "open"} },
    { "id": "S07", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1", "description": "DC main tie closed, so TRU 2 carries both DC main buses.",
      "states": {"TRU1": "failed", "DTC12": "closed"} },
    { "id": "S08", "name": "ESS TRU failure - TRU 1 feeds DC ESS", "description": "Tie DC1-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS and DC BAT.",
      "states": {"TRU4": "failed", "DTC1E": "closed"} },
    { "id": "S09", "name": "RAT both outputs - AC onto AC ESS, DC onto DC ESS", "description": "AC ESS isolated from AC BUS 1. The ESS TRU and the DC RAT output share DC ESS and DC BAT in proportion to continuous capacity.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RAT_DC": "available", "RLC": "closed", "RDC": "closed", "BTC1E": "open"} },
    { "id": "S10", "name": "RAT DC output only - AC output lost, DC RAT feeds DC ESS", "description": "Every AC bus is dead. The DC RAT output alone carries DC ESS and DC BAT, and the battery does not discharge.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_DC": "available", "RDC": "closed"} },
    { "id": "S11", "name": "Battery only - no AC power, RAT stowed", "description": "All generators lost and RAT stowed. The battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed"} },
    { "id": "S12", "name": "RAT AC onto AC ESS with tie to AC BUS 1 left closed", "description": "AC ESS not isolated, so the RAT also picks up AC BUS 1 and its galley: designed to fail, overload of the AC RAT output.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed"} },
    { "id": "S13", "name": "DC RAT with tie to DC BUS 1 closed", "description": "The DC RAT output is left carrying DC BUS 1 as well: designed to fail, overload of the DC RAT output.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_DC": "available", "RDC": "closed", "DTC1E": "closed"} },
    { "id": "S14", "name": "AC ESS alternate tie closed with both generators on line", "description": "Second AC ESS tie closed without opening the first: designed to fail, Generator 1 and Generator 2 paralleled through AC ESS.",
      "states": {"BTC2E": "closed"} },
    { "id": "S15", "name": "RAT DC available but line contactor open, battery contactor open", "description": "Neither DC source reaches DC ESS: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_DC": "available", "BATC": "open"} }
  ]
}
