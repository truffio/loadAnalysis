{
  "meta": {
    "aircraft": "Generic Widebody Twin",
    "revision": "A",
    "description": "Long-haul twin: 2 large 230 V engine generators, APU generator, RAT with separate AC and DC outputs, 4 TRUs including an ESS TRU, 2 galley buses shed by contactor, 1 battery. The DC RAT output feeds DC ESS. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
