  "scenarios": [
    { "id": "S01", "name": "Normal - both generators on line, APU off", "description": "Each generator feeds its own side. AC ESS and the ESS TRU are on AC BUS 2.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 2 loss - before crew action", "description": "Nothing transfers by itself. AC BUS 2, AC ESS and DC BUS 2 are dead and the battery carries DC ESS and DC BAT.",
      "states": {"GEN2": "failed"} },
    { "id": "S03", "name": "Generator 1 loss - APU feeds AC BUS 1", "description": "APU line contactor to AC BUS 1 closed. APU and Generator 2 stay on separate islands.",
      "states": {"GEN1": "failed", "APLC1": "closed"} },
    { "id": "S04", "name": "Generator 2 loss - APU feeds AC BUS 2", "description": "APU line contactor to AC BUS 2 closed. APU and Generator 1 stay on separate islands.",
      "states": {"GEN2": "failed", "APLC2": "closed"} },
    { "id": "S05", "name": "Generator 2 and APU loss - AC ESS moved to AC BUS 1", "description": "Normal AC ESS tie opened and alternate tie closed, so the ESS TRU comes back on Generator 1. AC BUS 2 and DC BUS 2 stay dead.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC2E": "open", "BTC1E": "closed"} },
    { "id": "S06", "name": "APU only - both engine generators lost", "description": "Both APU line contactors closed with the main tie open, so the APU feeds all AC buses.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "APLC2": "closed"} },
    { "id": "S07", "name": "Generator 1 and APU loss - Generator 2 feeds all AC", "description": "Main tie closed. Generator 2 carries the whole aircraft.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S08", "name": "Generator 2 and APU loss - Generator 1 feeds all AC", "description": "Main tie closed. Generator 1 carries the whole aircraft.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S09", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1", "description": "DC main tie closed, so TRU 2 carries both DC main buses.",
      "states": {"TRU1": "failed", "DTC12": "closed"} },
    { "id": "S10", "name": "ESS TRU failure - TRU 1 feeds DC ESS", "description": "Tie DC1-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS and DC BAT.",
      "states": {"TRU3": "failed", "DTC1E": "closed"} },
    { "id": "S11", "name": "RAT only - total generator loss", "description": "RAT deployed onto AC ESS with AC ESS isolated from AC BUS 2, so the RAT carries only the essential side through the ESS TRU.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed", "BTC2E": "open"} },
    { "id": "S12", "name": "Battery only - no AC power", "description": "All generators lost and RAT stowed. The battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed"} },
    { "id": "S13", "name": "RAT onto AC ESS with tie to AC BUS 2 left closed", "description": "AC ESS not isolated, so the RAT also picks up AC BUS 2 and TRU 2: designed to fail, overload of the RAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed"} },
    { "id": "S14", "name": "APU line contactor closed onto AC BUS 1 with Generator 1 on line", "description": "Designed to fail, APU and Generator 1 paralleled on AC BUS 1.",
      "states": {"APLC1": "closed"} },
    { "id": "S15", "name": "RAT deployed but line contactor open, battery failed", "description": "RAT available, but the RAT line contactor was left out and the battery has failed: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "BAT": "failed"} }
  ]
}
