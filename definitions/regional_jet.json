{
  "meta": {
    "aircraft": "Generic Regional Jet",
    "revision": "A",
    "description": "Two-engine regional jet: 2 engine AC generators, APU generator, AC RAT onto AC ESS, 2 main TRUs plus an ESS TRU, 1 battery. AC ESS is normally on AC BUS 2. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
  "sources": [
    { "id": "GEN1", "name": "Generator 1", "kind": "engine_generator", "engine": 1, "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 60000, "short_term": 50000, "continuous": 40000 }, "default_state": "operative" },
    { "id": "GEN2", "name": "Generator 2", "kind": "engine_generator", "engine": 2, "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 60000, "short_term": 50000, "continuous": 40000 }, "default_state": "operative" },
    { "id": "APUGEN", "name": "APU Generator", "kind": "apu_generator", "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 60000, "short_term": 50000, "continuous": 40000 }, "default_state": "operative" },
    { "id": "RAT_AC", "name": "RAT Generator (AC)", "kind": "emergency_generator", "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 10500, "short_term": 9000, "continuous": 7500 }, "safety_margin": 0.15, "default_state": "unavailable" },
    { "id": "BAT", "name": "Main Battery", "kind": "battery", "output": "DC", "voltage": 28,
      "capacity": { "transient": 5000, "short_term": 3500, "continuous": 2400 }, "default_state": "operative" }
  ],
  "buses": [
    { "id": "AC1", "name": "AC BUS 1", "type": "AC", "role": "main", "voltage": 115, "phases": 3,
      "capacity": { "transient": 67500, "short_term": 56250, "continuous": 45000 } },
    { "id": "AC2", "name": "AC BUS 2", "type": "AC", "role": "main", "voltage": 115, "phases": 3,
      "capacity": { "transient": 67500, "short_term": 56250, "continuous": 45000 } },
    { "id": "ACESS", "name": "AC ESS BUS", "type": "AC", "role": "essential", "voltage": 115, "phases": 3,
      "capacity": { "transient": 13500, "short_term": 11250, "continuous": 9000 } },
    { "id": "DC1", "name": "DC BUS 1", "type": "DC", "role": "main", "voltage": 28,
      "capacity": { "transient": 8400, "short_term": 7000, "continuous": 5600 } },
    { "id": "DC2", "name": "DC BUS 2", "type": "DC", "role": "main", "voltage": 28,
      "capacity": { "transient": 8400, "short_term": 7000, "continuous": 5600 } },
    { "id": "DCESS", "name": "DC ESS BUS", "type": "DC", "role": "essential", "voltage": 28,
      "capacity": { "transient": 6300, "short_term": 5250, "continuous": 4200 } },
    { "id": "DCBAT", "name": "DC BAT BUS", "type": "DC", "role": "battery", "voltage": 28, "crew_switch": true,
      "capacity": { "transient": 4200, "short_term": 3500, "continuous": 2800 } }
  ],
  "trus": [
    { "id": "TRU1", "name": "TRU 1", "input_bus": "AC1", "output_bus": "DC1", "efficiency": 0.85,
      "capacity": { "transient": 8400, "short_term": 7000, "continuous": 5600 }, "default_state": "operative" },
    { "id": "TRU2", "name": "TRU 2", "input_bus": "AC2", "output_bus": "DC2", "efficiency": 0.85,
      "capacity": { "transient": 8400, "short_term": 7000, "continuous": 5600 }, "default_state": "operative" },
    { "id": "TRU3", "name": "ESS TRU", "input_bus": "ACESS", "output_bus": "DCESS", "efficiency": 0.87,
      "capacity": { "transient": 5100, "short_term": 4250, "continuous": 3400 }, "default_state": "operative" }
  ],
  "contactors": [
    { "id": "GLC1", "name": "Gen 1 Line Contactor", "kind": "source", "from": "GEN1", "to": "AC1", "default_state": "closed" },
    { "id": "GLC2", "name": "Gen 2 Line Contactor", "kind": "source", "from": "GEN2", "to": "AC2", "default_state": "closed" },
    { "id": "APLC1", "name": "APU Line Contactor to AC BUS 1", "kind": "source", "from": "APUGEN", "to": "AC1", "default_state": "open" },
    { "id": "APLC2", "name": "APU Line Contactor to AC BUS 2", "kind": "source", "from": "APUGEN", "to": "AC2", "default_state": "open" },
    { "id": "RLC", "name": "RAT Line Contactor", "kind": "source", "from": "RAT_AC", "to": "ACESS", "default_state": "open" },
    { "id": "BATC", "name": "Battery Contactor", "kind": "source", "from": "BAT", "to": "DCBAT", "default_state": "closed" },
    { "id": "BTC12", "name": "Bus Tie AC1-AC2", "kind": "bus_tie", "from": "AC1", "to": "AC2",
      "capacity": { "transient": 60000, "short_term": 50000, "continuous": 40000 }, "default_state": "open" },
    { "id": "BTC1E", "name": "Bus Tie AC1-ACESS", "kind": "bus_tie", "from": "AC1", "to": "ACESS",
      "capacity": { "transient": 13500, "short_term": 11250, "continuous": 9000 }, "default_state": "open" },
    { "id": "BTC2E", "name": "Bus Tie AC2-ACESS", "kind": "bus_tie", "from": "AC2", "to": "ACESS",
      "capacity": { "transient": 13500, "short_term": 11250, "continuous": 9000 }, "default_state": "closed" },
    { "id": "DTC12", "name": "Bus Tie DC1-DC2", "kind": "bus_tie", "from": "DC1", "to": "DC2",
      "capacity": { "transient": 8400, "short_term": 7000, "continuous": 5600 }, "default_state": "open" },
    { "id": "DTC1E", "name": "Bus Tie DC1-DCESS", "kind": "bus_tie", "from": "DC1", "to": "DCESS",
      "capacity": { "transient": 6300, "short_term": 5250, "continuous": 4200 }, "default_state": "open" },
    { "id": "DTCEB", "name": "Bus Tie DCESS-DCBAT", "kind": "bus_tie", "from": "DCESS", "to": "DCBAT",
      "capacity": { "transient": 4200, "short_term": 3500, "continuous": 2800 }, "default_state": "closed" },
    { "id": "TRU1_IN", "name": "TRU 1 Input", "kind": "tru", "from": "AC1", "to": "TRU1", "default_state": "closed" },
    { "id": "TRU1_OUT", "name": "TRU 1 Output", "kind": "tru", "from": "TRU1", "to": "DC1", "default_state": "closed" },
    { "id": "TRU2_IN", "name": "TRU 2 Input", "kind": "tru", "from": "AC2", "to": "TRU2", "default_state": "closed" },
    { "id": "TRU2_OUT", "name": "TRU 2 Output", "kind": "tru", "from": "TRU2", "to": "DC2", "default_state": "closed" },
    { "id": "TRU3_IN", "name": "ESS TRU Input", "kind": "tru", "from": "ACESS", "to": "TRU3", "default_state": "closed" },
    { "id": "TRU3_OUT", "name": "ESS TRU Output", "kind": "tru", "from": "TRU3", "to": "DCESS", "default_state": "closed" }
  ],
