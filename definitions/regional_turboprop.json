{
  "meta": {
    "aircraft": "Generic Regional Turboprop",
    "revision": "A",
    "description": "Two-engine regional turboprop: 2 engine AC generators, no APU, no RAT, 2 TRUs, 1 battery. Split AC buses with a cross-tie, a sheddable cabin bus on AC BUS 2, and DC ESS normally on DC BUS 1. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
