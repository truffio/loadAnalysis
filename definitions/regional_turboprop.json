  "scenarios": [
    { "id": "S01", "name": "Normal - both generators on line", "description": "Each generator feeds its own side. DC ESS and DC BAT are on TRU 1 through DC BUS 1.",
      "states": {} },
    { "id": "S02", "name": "Generator 1 loss, no crew action - battery overloaded by DC BUS 1", "description": "Nothing transfers by itself. The battery is left carrying DC BUS 1 as well as DC ESS and DC BAT: designed to fail, overload of the battery.",
      "states": {"GEN1": "failed"} },
    { "id": "S03", "name": "Generator 1 loss - cross-tie closed, cabin bus shed", "description": "Generator 2 carries AC BUS 1 and AC BUS 2 with the cabin bus contactor open.",
      "states": {"GEN1": "failed", "BTC12": "closed", "CABC": "open"} },
    { "id": "S04", "name": "Generator 2 loss - cross-tie closed, cabin bus shed", "description": "Generator 1 carries AC BUS 1 and AC BUS 2 with the cabin bus contactor open.",
      "states": {"GEN2": "failed", "BTC12": "closed", "CABC": "open"} },
    { "id": "S05", "name": "TRU 1 failure - TRU 2 feeds all DC through DC ESS", "description": "Tie DC2-DCESS closed, so TRU 2 carries the chain DC BUS 2, DC ESS, DC BUS 1 and DC BAT.",
      "states": {"TRU1": "failed", "DTC2E": "closed"} },
    { "id": "S06", "name": "TRU 2 failure - TRU 1 feeds all DC through DC ESS", "description": "Tie DC2-DCESS closed, so TRU 1 carries the chain DC BUS 1, DC ESS, DC BUS 2 and DC BAT.",
      "states": {"TRU2": "failed", "DTC2E": "closed"} },
    { "id": "S07", "name": "Both TRUs failed - battery carries DC ESS and DC BAT", "description": "AC stays up on both generators. DC BUS 1 is isolated so the battery carries only the essential side.",
      "states": {"TRU1": "failed", "TRU2": "failed", "DTC1E": "open"} },
    { "id": "S08", "name": "Battery only - both generators lost", "description": "Every AC bus is dead. DC BUS 1 is isolated from DC ESS and the battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "DTC1E": "open"} },
    { "id": "S09", "name": "Generator 2 loss - cross-tie closed, cabin bus not shed", "description": "Generator 1 carries the whole aircraft with the cabin bus still on: designed to fail, overload of Generator 1.",
      "states": {"GEN2": "failed", "BTC12": "closed"} },
    { "id": "S10", "name": "Cross-tie closed with both generators on line", "description": "Designed to fail, Generator 1 and Generator 2 paralleled through the cross-tie.",
      "states": {"BTC12": "closed"} },
    { "id": "S11", "name": "Both generators lost, battery contactor left open", "description": "The battery is healthy but not connected: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "GEN2": "failed", "BATC": "open"} }
  ]
