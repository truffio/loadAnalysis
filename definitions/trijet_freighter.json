{
  "meta": {
    "aircraft": "Generic Trijet Freighter",
    "revision": "A",
    "description": "Three-engine freighter: 3 engine AC generators, APU generator, 3 main AC buses in a tied chain, a crew-switched AC cargo bus, 2 main TRUs plus an ESS TRU, 1 battery. No RAT. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
  "sources": [
    { "id": "GEN1", "name": "Generator 1", "kind": "engine_generator", "engine": 1, "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 112500, "short_term": 93750, "continuous": 75000 }, "default_state": "operative" },
    { "id": "GEN2", "name": "Generator 2", "kind": "engine_generator", "engine": 2, "output": "AC", "voltage": 115, "phases": 3,
