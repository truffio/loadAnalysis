  "scenarios": [
    { "id": "S01", "name": "Normal - three generators on line, APU off", "description": "Each generator feeds its own main bus. Cargo bus is on AC BUS 2, AC ESS on AC BUS 3.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - Generator 2 feeds AC BUS 1", "description": "Tie AC1-AC2 closed. Generator 2 carries AC BUS 1, AC BUS 2 and the cargo bus.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S03", "name": "Generator 2 loss - APU feeds AC BUS 2", "description": "APU replaces Generator 2 on the middle bus.",
      "states": {"GEN2": "failed", "APLC2": "closed"} },
    { "id": "S04", "name": "Generator 3 loss - Generator 2 feeds AC BUS 3", "description": "Tie AC2-AC3 closed. Generator 2 carries AC BUS 2, AC BUS 3, AC ESS and the cargo bus.",
      "states": {"GEN3": "failed", "APUGEN": "failed", "BTC23": "closed"} },
    { "id": "S05", "name": "Generators 1 and 2 lost - APU feeds AC BUS 1 and 2", "description": "APU onto AC BUS 2 with tie AC1-AC2 closed. Generator 3 stays on its own island.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC2": "closed", "BTC12": "closed"} },
    { "id": "S06", "name": "Generators 2 and 3 and APU lost - Generator 1 feeds all, cargo bus off", "description": "Both main ties closed and the cargo bus crew switch off.",
      "states": {"GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC23": "closed", "ACCGO": "off"} },
    { "id": "S07", "name": "APU only - all engine generators lost, cargo bus off", "description": "APU onto AC BUS 2 with both main ties closed and the cargo bus crew switch off.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "APLC2": "closed", "BTC12": "closed", "BTC23": "closed", "ACCGO": "off"} },
    { "id": "S08", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1", "description": "DC main tie closed, so TRU 2 carries both DC main buses.",
      "states": {"TRU1": "failed", "DTC12": "closed"} },
    { "id": "S09", "name": "ESS TRU failure - TRU 1 feeds DC ESS", "description": "Tie DC1-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS and DC BAT.",
      "states": {"TRU3": "failed", "DTC1E": "closed"} },
    { "id": "S10", "name": "Battery only - all generators lost", "description": "No RAT on this aircraft. The battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "APUGEN": "failed"} },
    { "id": "S11", "name": "Generators 2 and 3 and APU lost - cargo bus left on", "description": "Generator 1 carries the whole aircraft with the cargo bus still on: designed to fail, overload of Generator 1.",
      "states": {"GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC23": "closed"} },
    { "id": "S12", "name": "Tie AC1-AC2 closed with both generators on line", "description": "Designed to fail, Generator 1 and Generator 2 paralleled through the tie.",
      "states": {"BTC12": "closed"} },
    { "id": "S13", "name": "Generator 3 loss, no transfer, battery failed", "description": "AC ESS and the ESS TRU are lost with Generator 3, and there is no battery behind DC ESS: designed to fail on unpowered essential loads.",
      "states": {"GEN3": "failed", "BAT": "failed"} }
  ]
}
