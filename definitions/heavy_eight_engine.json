    { "id": "S07", "name": "Generators 7 and 8 lost, right outer pair - Generator 6 feeds three buses", "description": "Ties AC6-AC7 and AC7-AC8 closed.",
      "states": {"GEN7": "failed", "GEN8": "failed", "BTC67": "closed", "BTC78": "closed"} },
    { "id": "S08", "name": "Generators 1 and 4 lost, left wing split", "description": "Ties AC1-AC2 and AC3-AC4 closed. Generators 2 and 3 each carry two buses.",
      "states": {"GEN1": "failed", "GEN4": "failed", "BTC12": "closed", "BTC34": "closed"} },
    { "id": "S09", "name": "Generators 4 and 5 lost, one on each wing", "description": "Ties AC3-AC4 and AC5-AC6 closed.",
