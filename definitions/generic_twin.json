  "scenarios": [
    { "id": "S01", "name": "Normal - both IDGs on line, APU off",
      "description": "Each generator feeds its own side. AC ESS is on AC BUS 1. The battery floats on DC BAT.",
      "states": { "APUGEN": "failed" } },
    { "id": "S02", "name": "Generator 1 loss - before crew action",
      "description": "Nothing transfers by itself. AC BUS 1, AC ESS and DC BUS 1 are dead, and the battery carries DC ESS and DC BAT.",
      "states": { "GEN1": "failed" } },
    { "id": "S03", "name": "Generator 1 loss - APU feeds AC BUS 1",
      "description": "APU line contactor to AC BUS 1 closed. The APU and Generator 2 stay on separate islands.",
      "states": { "GEN1": "failed", "APLC1": "closed" } },
    { "id": "S04", "name": "Generator 2 loss - APU feeds AC BUS 2",
      "description": "APU line contactor to AC BUS 2 closed. The APU and Generator 1 stay on separate islands.",
      "states": { "GEN2": "failed", "APLC2": "closed" } },
    { "id": "S05", "name": "APU only - both engine generators lost",
      "description": "Both APU line contactors closed, so the APU feeds AC BUS 1 and AC BUS 2 with the main tie open.",
      "states": { "GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "APLC2": "closed" } },
    { "id": "S06", "name": "Generator 1 and APU loss - Generator 2 feeds all AC",
      "description": "Main tie closed, and AC ESS transferred to AC BUS 2 by opening its normal tie first.",
      "states": { "GEN1": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC1E": "open", "BTC2E": "closed" } },
    { "id": "S07", "name": "Generator 2 and APU loss - Generator 1 feeds all AC",
      "description": "Main tie closed. AC ESS stays on AC BUS 1.",
      "states": { "GEN2": "failed", "APUGEN": "failed", "BTC12": "closed" } },
    { "id": "S08", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1",
      "description": "DC main tie closed, so TRU 2 carries both DC main buses.",
      "states": { "TRU1": "failed", "DTC12": "closed" } },
    { "id": "S09", "name": "TRU 2 failure - TRU 1 and ESS TRU share all DC",
      "description": "Both DC ties closed. The two TRUs share all four DC buses in proportion to continuous capacity.",
      "states": { "TRU2": "failed", "DTC12": "closed", "DTC1E": "closed" } },
    { "id": "S10", "name": "ESS TRU failure - TRU 1 feeds DC ESS",
      "description": "Tie DC BUS 1 to DC ESS closed, so TRU 1 carries DC BUS 1, DC ESS and DC BAT.",
      "states": { "TRU3": "failed", "DTC1E": "closed" } },
    { "id": "S11", "name": "RAT only - total generator loss",
      "description": "RAT deployed onto AC ESS, with AC ESS isolated from AC BUS 1 so the RAT carries only the essential side.",
      "states": { "GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed", "BTC1E": "open" } },
    { "id": "S12", "name": "Battery only - no AC power",
      "description": "All generators lost and RAT stowed. Every AC bus is dead, and the battery carries DC ESS and DC BAT.",
      "states": { "GEN1": "failed", "GEN2": "failed", "APUGEN": "failed" } },
    { "id": "S13", "name": "Dual TRU failure - TRU 1 carries all DC",
      "description": "TRU 2 and the ESS TRU failed, both DC ties closed: designed to fail by overload of TRU 1.",
      "states": { "TRU2": "failed", "TRU3": "failed", "DTC12": "closed", "DTC1E": "closed" } },
    { "id": "S14", "name": "DC BAT crew switch left off",
      "description": "Normal power with the battery bus switch off: designed to fail on unpowered essential loads, with no overload.",
      "states": { "DCBAT": "off" } },
    { "id": "S15", "name": "AC ESS alternate tie closed with both generators on line",
      "description": "Second AC ESS tie closed without opening the first: designed to fail, Generator 1 and Generator 2 paralleled through AC ESS.",
      "states": { "BTC2E": "closed" } }
  ]
}
