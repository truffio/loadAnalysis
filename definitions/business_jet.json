  "scenarios": [
    { "id": "S01", "name": "Normal - both generators on line, APU off", "description": "Each generator feeds its own side. The cabin bus is on AC BUS 2 and AC ESS on AC BUS 1.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - APU feeds AC BUS 1", "description": "APU line contactor to AC BUS 1 closed.",
      "states": {"GEN1": "failed", "APLC1": "closed"} },
    { "id": "S03", "name": "Generator 2 loss - APU feeds AC BUS 2", "description": "APU line contactor to AC BUS 2 closed. The cabin bus stays on.",
      "states": {"GEN2": "failed", "APLC2": "closed"} },
    { "id": "S04", "name": "Generator 1 and APU loss - cross-tie carries AC BUS 1 side", "description": "Cross-tie closed. Its flow is AC BUS 1, AC ESS and their TRUs, within the tie rating.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S05", "name": "Generator 2 and APU loss - cross-tie closed, cabin bus shed", "description": "Cabin contactor opened first, so the tie carries only AC BUS 2 and TRU 2.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed", "CABC": "open"} },
    { "id": "S06", "name": "APU only - both generators lost, cabin bus shed", "description": "Both APU line contactors closed with the cross-tie open.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "APLC2": "closed", "CABC": "open"} },
    { "id": "S07", "name": "TRU 2 failure - TRU 1 feeds DC BUS 2", "description": "DC main tie closed, so TRU 1 carries both DC main buses.",
      "states": {"TRU2": "failed", "DTC12": "closed"} },
    { "id": "S08", "name": "ESS TRU failure - TRU 1 feeds DC ESS", "description": "Tie DC1-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS, DC BAT and DC STBY.",
      "states": {"TRU3": "failed", "DTC1E": "closed"} },
    { "id": "S09", "name": "RAT only - total generator loss", "description": "RAT onto AC ESS, isolated from AC BUS 1. The ESS TRU carries all essential DC.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed", "BTC1E": "open"} },
    { "id": "S10", "name": "Battery only - both batteries share essential DC", "description": "All generators lost and RAT stowed. The tie DCBAT-DCSTBY stays closed and the two batteries share in proportion to continuous capacity.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed"} },
    { "id": "S11", "name": "Battery only - batteries split, each on its own bus", "description": "Tie DCBAT-DCSTBY open. The standby battery keeps DC STBY alone.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "DTCBS": "open"} },
    { "id": "S12", "name": "Generator 2 and APU loss - cross-tie closed, cabin bus not shed", "description": "The cabin bus stays on, so the flow over the cross-tie exceeds its rating. Generator 1 is within limits: designed to fail, overload of the tie only.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S13", "name": "AC ESS alternate tie closed with both generators on line", "description": "Designed to fail, Generator 1 and Generator 2 paralleled through AC ESS.",
      "states": {"BTC2E": "closed"} },
    { "id": "S14", "name": "Standby battery failed with tie to DC STBY open", "description": "Normal power, but DC STBY has lost both feeds: designed to fail on unpowered essential loads.",
      "states": {"BAT2": "failed", "DTCBS": "open"} }
  ]
}
