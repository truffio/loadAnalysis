      "capacity": { "transient": 21000, "short_term": 17500, "continuous": 14000 }, "default_state": "open" },
    { "id": "MSNC", "name": "AC Mission Bus Shed Contactor", "kind": "bus_tie", "from": "AC2", "to": "ACMSN",
