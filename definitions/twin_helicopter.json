{
  "meta": {
    "aircraft": "Generic Twin Utility Helicopter",
    "revision": "A",
    "description": "Twin-engine utility helicopter: 2 engine AC generators, no APU, no RAT, 2 TRUs, 1 battery, an AC mission bus shed by contactor and a crew-switched DC mission bus. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
  "sources": [
    { "id": "GEN1", "name": "Generator 1", "kind": "engine_generator", "engine": 1, "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 21000, "short_term": 17500, "continuous": 14000 }, "default_state": "operative" },
    { "id": "GEN2", "name": "Generator 2", "kind": "engine_generator", "engine": 2, "output": "AC", "voltage": 115, "phases": 3,
      "capacity": { "transient": 21000, "short_term": 17500, "continuous": 14000 }, "default_state": "operative" },
    { "id": "BAT", "name": "Main Battery", "kind": "battery", "output": "DC", "voltage": 28,
      "capacity": { "transient": 3000, "short_term": 2000, "continuous": 1400 }, "default_state": "operative" }
  ],
  "buses": [
    { "id": "AC1", "name": "AC BUS 1", "type": "AC", "role": "main", "voltage": 115, "phases": 3,
      "capacity": { "transient": 24000, "short_term": 20000, "continuous": 16000 } },
    { "id": "AC2", "name": "AC BUS 2", "type": "AC", "role": "main", "voltage": 115, "phases": 3,
      "capacity": { "transient": 24000, "short_term": 20000, "continuous": 16000 } },
    { "id": "ACMSN", "name": "AC MISSION BUS", "type": "AC", "role": "other", "voltage": 115, "phases": 3,
      "capacity": { "transient": 11250, "short_term": 9375, "continuous": 7500 } },
    { "id": "DC1", "name": "DC BUS 1", "type": "DC", "role": "main", "voltage": 28,
      "capacity": { "transient": 6300, "short_term": 5250, "continuous": 4200 } },
    { "id": "DC2", "name": "DC BUS 2", "type": "DC", "role": "main", "voltage": 28,
      "capacity": { "transient": 6300, "short_term": 5250, "continuous": 4200 } },
    { "id": "DCMSN", "name": "DC MISSION BUS", "type": "DC", "role": "other", "voltage": 28, "crew_switch": true,
      "capacity": { "transient": 2100, "short_term": 1750, "continuous": 1400 } },
    { "id": "DCESS", "name": "DC ESS BUS", "type": "DC", "role": "essential", "voltage": 28,
      "capacity": { "transient": 4200, "short_term": 3500, "continuous": 2800 } },
    { "id": "DCBAT", "name": "DC BAT BUS", "type": "DC", "role": "battery", "voltage": 28, "crew_switch": true,
      "capacity": { "transient": 2100, "short_term": 1750, "continuous": 1400 } }
