  "scenarios": [
    { "id": "S01", "name": "Normal - both generators on line, mission buses on", "description": "Each generator feeds its own side. The AC mission bus is on AC BUS 2 and the DC mission bus on DC BUS 2.",
      "states": {} },
    { "id": "S02", "name": "Generator 1 loss - cross-tie closed, AC mission bus shed", "description": "Generator 2 carries both AC buses. The hoist, searchlight and medical rack are shed.",
      "states": {"GEN1": "failed", "BTC12": "closed", "MSNC": "open"} },
    { "id": "S03", "name": "Generator 2 loss - cross-tie closed, AC mission bus shed", "description": "Generator 1 carries both AC buses. The hoist, searchlight and medical rack are shed.",
      "states": {"GEN2": "failed", "BTC12": "closed", "MSNC": "open"} },
    { "id": "S04", "name": "TRU 1 failure - TRU 2 feeds all DC through DC ESS", "description": "Tie DC2-DCESS closed, so TRU 2 carries DC BUS 2, DC ESS, DC BUS 1 and both crew-switched buses, with the DC mission bus switched off.",
      "states": {"TRU1": "failed", "DTC2E": "closed", "DCMSN": "off"} },
    { "id": "S05", "name": "TRU 2 failure - TRU 1 feeds all DC through DC ESS", "description": "Tie DC2-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS, DC BUS 2 and both crew-switched buses, with the DC mission bus switched off.",
      "states": {"TRU2": "failed", "DTC2E": "closed", "DCMSN": "off"} },
    { "id": "S06", "name": "Battery only - both generators lost", "description": "DC BUS 1 isolated, and the battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "DTC1E": "open"} },
    { "id": "S07", "name": "Generator 1 loss - cross-tie closed, AC mission bus left on", "description": "Generator 2 carries the hoist and the whole aircraft: designed to fail, overload of Generator 2.",
      "states": {"GEN1": "failed", "BTC12": "closed"} },
    { "id": "S08", "name": "Both TRUs failed - battery left on DC BUS 1", "description": "DC BUS 1 not isolated, so the battery carries it as well as DC ESS and DC BAT: designed to fail, overload of the battery.",
      "states": {"TRU1": "failed", "TRU2": "failed"} },
    { "id": "S09", "name": "Cross-tie closed with both generators on line", "description": "Designed to fail, Generator 1 and Generator 2 paralleled through the cross-tie.",
      "states": {"BTC12": "closed"} },
    { "id": "S10", "name": "Both generators lost, battery contactor left open", "description": "The battery is healthy but not connected: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "GEN2": "failed", "BATC": "open"} }
  ]
