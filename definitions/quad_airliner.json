  "scenarios": [
    { "id": "S01", "name": "Normal - four generators on line, four TRUs share DC", "description": "Each generator feeds its own main bus. All four TRUs feed one DC island through DC ESS and share it in proportion to continuous capacity.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - Generator 2 feeds AC BUS 1", "description": "Tie AC1-AC2 closed. Generator 2 carries AC BUS 1, AC BUS 2 and AC ESS.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S03", "name": "Generator 4 loss - Generator 3 feeds AC BUS 4", "description": "Tie AC3-AC4 closed. Generator 3 carries AC BUS 3 and AC BUS 4.",
      "states": {"GEN4": "failed", "APUGEN": "failed", "BTC34": "closed"} },
    { "id": "S04", "name": "Generator 3 loss - APU feeds AC BUS 3", "description": "APU replaces Generator 3, so no bus tie is needed.",
      "states": {"GEN3": "failed", "APLC3": "closed"} },
    { "id": "S05", "name": "Generators 1 and 2 lost, left side - APU feeds AC BUS 1 and 2", "description": "APU onto AC BUS 2 with tie AC1-AC2 closed.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC2": "closed", "BTC12": "closed"} },
    { "id": "S06", "name": "Generators 1 and 4 lost, outboard pair, APU off", "description": "Ties AC1-AC2 and AC3-AC4 closed. Generators 2 and 3 each carry two main buses.",
      "states": {"GEN1": "failed", "GEN4": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC34": "closed"} },
    { "id": "S07", "name": "Generators 2 and 3 lost, inboard pair, APU off", "description": "Ties AC1-AC2 and AC3-AC4 closed. Generators 1 and 4 each carry two main buses.",
      "states": {"GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC34": "closed"} },
    { "id": "S08", "name": "TRU 3 failure - remaining three TRUs share DC", "description": "No contactor action. The DC island shares across TRU 1, ESS TRU and TRU 4.",
      "states": {"TRU3": "failed"} },
    { "id": "S09", "name": "TRU 1 and TRU 4 failure - TRU 3 and ESS TRU share DC", "description": "No contactor action. Two TRUs of unequal size carry all DC buses.",
      "states": {"TRU1": "failed", "TRU4": "failed"} },
    { "id": "S10", "name": "RAT only - total generator loss", "description": "RAT onto AC ESS, isolated from AC BUS 2. The DC main buses are isolated so the ESS TRU carries only DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "GEN4": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed", "BTC2E": "open", "DTC1E": "open", "DTC2E": "open"} },
    { "id": "S11", "name": "Battery only - no AC power", "description": "All generators lost and RAT stowed. DC main buses isolated, and the battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "GEN4": "failed", "APUGEN": "failed", "DTC1E": "open", "DTC2E": "open"} },
    { "id": "S12", "name": "Three TRUs failed - ESS TRU carries all DC", "description": "TRU 1, TRU 3 and TRU 4 failed with the DC island still tied: designed to fail, overload of the ESS TRU.",
      "states": {"TRU1": "failed", "TRU3": "failed", "TRU4": "failed"} },
    { "id": "S13", "name": "Three generators and APU lost - Generator 4 carries all four buses", "description": "All three main ties closed with no load shed: designed to fail, overload of Generator 4.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC23": "closed", "BTC34": "closed"} },
    { "id": "S14", "name": "Tie AC2-AC3 closed with all generators on line", "description": "Designed to fail, Generator 2 and Generator 3 paralleled through the tie.",
      "states": {"BTC23": "closed"} },
    { "id": "S15", "name": "RAT only with ESS TRU and battery failed", "description": "RAT feeds AC ESS, but no DC source is left: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "GEN4": "failed", "APUGEN": "failed", "RAT_AC": "available", "RLC": "closed", "BTC2E": "open", "TRU2": "failed", "BAT": "failed"} }
  ]
