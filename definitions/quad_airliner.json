{
  "meta": {
    "aircraft": "Generic Quad Airliner",
    "revision": "A",
    "description": "Four-engine airliner: 4 engine AC generators, APU generator, AC RAT onto AC ESS, 4 main AC buses in a tied chain, 3 main TRUs and an ESS TRU sharing one DC island, 1 battery. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
