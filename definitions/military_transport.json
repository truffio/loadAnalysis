  "scenarios": [
    { "id": "S01", "name": "Normal - four generators on line, mission buses on", "description": "Each generator feeds its own main bus. The mission buses are on AC BUS 2.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - Generator 2 feeds AC BUS 1", "description": "Tie AC1-AC2 closed. Generator 2 carries AC BUS 1, AC BUS 2 and the mission buses.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S03", "name": "Generator 3 loss - Generator 4 feeds AC BUS 3", "description": "Tie AC3-AC4 closed. Generator 4 carries AC BUS 3 and AC BUS 4.",
      "states": {"GEN3": "failed", "APUGEN": "failed", "BTC34": "closed"} },
    { "id": "S04", "name": "Generator 1 loss - APU feeds AC BUS 1", "description": "APU replaces Generator 1, so no bus tie is needed.",
      "states": {"GEN1": "failed", "APLC1": "closed"} },
    { "id": "S05", "name": "Generators 1 and 2 lost - APU feeds AC BUS 1 and 2, mission moved to AC BUS 3", "description": "APU onto AC BUS 1 with tie AC1-AC2 closed. The mission bus changes over to AC BUS 3.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "BTC12": "closed", "MSNC2": "open", "MSNC3": "closed"} },
    { "id": "S06", "name": "Generators 3 and 4 lost - APU feeds AC BUS 3 and 4", "description": "APU onto AC BUS 4 with tie AC3-AC4 closed. The mission buses stay on Generator 2.",
      "states": {"GEN3": "failed", "GEN4": "failed", "APLC4": "closed", "BTC34": "closed"} },
    { "id": "S07", "name": "Generators 1 and 4 lost, outboard pair, APU off", "description": "Ties AC1-AC2 and AC3-AC4 closed. Generators 2 and 3 each carry two main buses.",
      "states": {"GEN1": "failed", "GEN4": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC34": "closed"} },
    { "id": "S08", "name": "Generators 2 and 3 lost, inboard pair, APU off", "description": "Ties AC1-AC2 and AC3-AC4 closed. Generator 1 also carries the mission buses.",
      "states": {"GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC34": "closed"} },
    { "id": "S09", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1 through DC ESS", "description": "Tie DC2-DCESS closed, so TRU 2 carries DC BUS 2, DC ESS, DC BUS 1 and DC BAT.",
      "states": {"TRU1": "failed", "DTC2E": "closed"} },
    { "id": "S10", "name": "Mission TRU failure - DC mission bus moved to DC BUS 2", "description": "Tie DC2-DCMSN closed, so TRU 2 carries DC BUS 2 and the DC mission bus.",
      "states": {"TRU3": "failed", "DTCM2": "closed"} },
    { "id": "S11", "name": "Battery only - all generators lost", "description": "No RAT on this aircraft. DC BUS 1 isolated, and the battery carries DC ESS and DC BAT.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "GEN4": "failed", "APUGEN": "failed", "DTC1E": "open"} },
    { "id": "S12", "name": "TRU 1 and Mission TRU failed - TRU 2 carries all DC", "description": "Both DC ties closed with the mission bus still on: designed to fail, overload of TRU 2.",
      "states": {"TRU1": "failed", "TRU3": "failed", "DTC2E": "closed", "DTCM2": "closed"} },
    { "id": "S13", "name": "Three generators and APU lost - Generator 4 carries the mission", "description": "All main ties closed with both mission buses on: designed to fail, overload of Generator 4.",
      "states": {"GEN1": "failed", "GEN2": "failed", "GEN3": "failed", "APUGEN": "failed", "BTC12": "closed", "BTC23": "closed", "BTC34": "closed"} },
    { "id": "S14", "name": "Both mission bus contactors closed", "description": "Designed to fail, Generator 2 and Generator 3 paralleled through the AC mission bus.",
      "states": {"MSNC3": "closed"} },
    { "id": "S15", "name": "DC ESS feed opened with battery contactor open", "description": "DC ESS and DC BAT are left with no source while the aircraft has full AC: designed to fail on unpowered essential loads.",
      "states": {"DTC1E": "open", "BATC": "open"} }
  ]
}
