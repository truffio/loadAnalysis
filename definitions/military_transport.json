{
  "meta": {
    "aircraft": "Generic Military Transport",
    "revision": "A",
    "description": "Four-engine turboprop transport: 4 engine AC generators, APU generator, no RAT, 4 main AC buses in a tied chain, an AC mission bus, a crew-switched DC mission bus on its own TRU, 3 TRUs, 1 battery. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.15,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
  "sources": [
    { "id": "GEN1", "name": "Generator 1", "kind": "engine_generator", "engine": 1, "output": "AC", "voltage": 115, "phases": 3,
