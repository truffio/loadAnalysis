  "scenarios": [
    { "id": "S01", "name": "Normal - split bus, cross-tie open, APU off", "description": "Each generator feeds its own side and its own galley bus.",
      "states": {"APUGEN": "failed"} },
    { "id": "S02", "name": "Generator 1 loss - APU feeds AC BUS 1", "description": "Split bus kept. Both galleys stay on.",
      "states": {"GEN1": "failed", "APLC1": "closed"} },
    { "id": "S03", "name": "Generator 2 loss - APU feeds AC BUS 2", "description": "Split bus kept. Both galleys stay on.",
      "states": {"GEN2": "failed", "APLC2": "closed"} },
    { "id": "S04", "name": "Generator 1 and APU loss - cross-tie closed, forward galley shed", "description": "Generator 2 carries both sides. Forward galley contactor opened before the tie closes.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC12": "closed", "GAL1C": "open"} },
    { "id": "S05", "name": "Generator 2 and APU loss - cross-tie closed, aft galley shed", "description": "Generator 1 carries both sides. Aft galley contactor opened before the tie closes.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed", "GAL2C": "open"} },
    { "id": "S06", "name": "Generator 1 and APU loss - AC ESS moved to AC BUS 2, split bus kept", "description": "Normal AC ESS tie opened and alternate tie closed. The cross-tie stays open, so AC BUS 1, the forward galley and DC BUS 1 stay dead.",
      "states": {"GEN1": "failed", "APUGEN": "failed", "BTC1E": "open", "BTC2E": "closed"} },
    { "id": "S07", "name": "APU only - both generators lost, both galleys shed", "description": "Both APU line contactors closed with the cross-tie open.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APLC1": "closed", "APLC2": "closed", "GAL1C": "open", "GAL2C": "open"} },
    { "id": "S08", "name": "TRU 1 failure - TRU 2 feeds DC BUS 1", "description": "DC main tie closed, so TRU 2 carries both DC main buses.",
      "states": {"TRU1": "failed", "DTC12": "closed"} },
    { "id": "S09", "name": "ESS TRU failure - TRU 1 feeds DC ESS", "description": "Tie DC1-DCESS closed, so TRU 1 carries DC BUS 1, DC ESS and DC BAT.",
      "states": {"TRU3": "failed", "DTC1E": "closed"} },
    { "id": "S10", "name": "Battery only - both batteries share DC ESS and DC BAT", "description": "All generators lost. The two batteries share in proportion to continuous capacity.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed"} },
    { "id": "S11", "name": "Battery only - Battery 2 failed, Battery 1 alone", "description": "All generators lost and one battery failed. Battery 1 carries DC ESS and DC BAT alone.",
      "states": {"GEN1": "failed", "GEN2": "failed", "APUGEN": "failed", "BAT2": "failed"} },
    { "id": "S12", "name": "Generator 2 and APU loss - cross-tie closed, galleys not shed", "description": "Generator 1 carries both galleys: designed to fail, overload of Generator 1.",
      "states": {"GEN2": "failed", "APUGEN": "failed", "BTC12": "closed"} },
    { "id": "S13", "name": "Cross-tie closed with both generators on line", "description": "Designed to fail, Generator 1 and Generator 2 paralleled through the cross-tie.",
      "states": {"BTC12": "closed"} },
    { "id": "S14", "name": "Generator 1 loss with both battery contactors open", "description": "AC ESS and the ESS TRU are lost with Generator 1, and the batteries are disconnected: designed to fail on unpowered essential loads.",
      "states": {"GEN1": "failed", "BATC1": "open", "BATC2": "open"} }
  ]
}
