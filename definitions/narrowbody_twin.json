{
  "meta": {
    "aircraft": "Generic Narrowbody Twin",
    "revision": "A",
    "description": "Single-aisle twin: 2 engine AC generators and APU generator on a split bus with a cross-tie, 2 galley buses shed by contactor, 2 main TRUs plus an ESS TRU, 2 batteries on the battery bus. All figures are illustrative and not from any real aircraft."
  },
  "settings": {
    "safety_margin": 0.1,
    "bands": {
      "transient": { "label": "Transient" },
      "short_term": { "label": "5 s", "duration_s": 5 },
      "continuous": { "label": "Continuous" }
    }
  },
  "sources": [
    { "id": "GEN1", "name": "Generator 1", "kind": "engine_generator", "engine": 1, "output": "AC", "voltage": 115, "phases": 3,
